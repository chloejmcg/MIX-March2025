# Chunk 26: assumptions
# height
# Residuals vs Fitted plot to check linearity
plot(model_height, which = 1) # YAY looks good
# Q-Q plot to check normality of residuals
qqnorm(resid(model_height))
qqline(resid(model_height)) # there is some deviation at the tails, i think
# Residuals vs Fitted plot to check homoscedasticity
plot(model_height, which = 1)
# Check residuals for autocorrelation
acf(resid(model_height)) # there is no pattern for homoscedasticity
# width
plot(model_width, which = 1) # YAY looks good
# Q-Q plot to check normality of residuals
qqnorm(resid(model_width))
qqline(resid(model_width)) # there is some deviation at the tails, i think
# Residuals vs Fitted plot to check homoscedasticity
plot(model_width, which = 1)
# Check residuals for autocorrelation
acf(resid(model_width)) # there is no pattern for homoscedasticity
# SA
plot(model_SA, which = 1) # YAY looks good
# Q-Q plot to check normality of residuals
qqnorm(resid(model_SA))
qqline(resid(model_SA)) # there is some deviation at the tails, i think
# Residuals vs Fitted plot to check homoscedasticity
plot(model_height, which = 1)
# Check residuals for autocorrelation
acf(resid(model_height)) # there is no pattern for homoscedasticity
