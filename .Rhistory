)
# Classify bacteriocin AOIs based on known domain/keyword patterns
bacteriocin_classes <- antimicrobial_hits %>%
mutate(
Class = case_when(
str_detect(Pfam_Info, regex("LanC|LanB|LanM|Lantibiotic|dehydratase|RiPP", ignore_case = TRUE)) ~ "Class I (RiPP, modified)",
str_detect(Pfam_Info, regex("double-glycine|ABC_transporter|Pediocin|Plantarcin|Enterocin|Immunity", ignore_case = TRUE)) ~ "Class II (unmodified, small peptides)",
str_detect(Pfam_Info, regex("cell_wall|hydrolase|lytic|muramidase|endopeptidase", ignore_case = TRUE)) ~ "Class III (large, lytic)",
TRUE ~ "Unclassified"
)
)
